title: LSASS Memory Access
id: f6a7b8c9-d0e1-2345-f012-456789012345
status: experimental
description: Detects access to LSASS memory by non-system processes.
author: Your Name
date: 2026/01/08
references:
  - https://attack.mitre.org/techniques/T1003/001/
logsource:
  category: process_access
  product: windows
detection:
  selection:
    EventID: 10
    TargetImage|endswith: '\\lsass.exe'
  not_system:
    SourceImage|endswith:
      - '\\taskmgr.exe'
      - '\\procdump.exe'
      - '\\comsvcs.dll'
  condition: selection and not_system
falsepositives:
  - Legitimate system tools accessing LSASS.
level: high
tags:
  - attack.credential_access
  - attack.t1003.001
